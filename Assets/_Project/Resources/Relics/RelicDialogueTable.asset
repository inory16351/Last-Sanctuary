%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c0060fe4ab43d4428251652a4b7f6c1, type: 3}
  m_Name: RelicDialogueTable
  m_EditorClassIdentifier:
  lines:
  - dialogueId: 650101
    groupId: 1
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "흙이 부자연스럽게 부풀어 있습니다.\n무언가 묻혀 있는 것은 분명하지만, 위험이 도사리고 있을지도 모릅니다...."
    scriptKey: "relic_dialogue_650101"
  - dialogueId: 650102
    groupId: 1
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "땅 아래에서 미약한 박동이 올라옵니다.\n성역의 것인지 침입자의 것인지는 알 수 없습니다. 위험이 도사리고 있을지도 모릅니다...."
    scriptKey: "relic_dialogue_650102"
  - dialogueId: 650103
    groupId: 1
    situation: 2
    choiceGroupId: 640001
    weight: 10
    script: "천사 하나가 조심스레 다가가 흙을 헤집습니다.\n손끝에 무언가 단단한 것이 걸립니다."
    scriptKey: "relic_dialogue_650103"
  - dialogueId: 650104
    groupId: 1
    situation: 3
    choiceGroupId: 640001
    weight: 10
    script: "천사들은 그 자리를 멀찍이 돌아갑니다.\n부푼 흙은 그대로 남았습니다."
    scriptKey: "relic_dialogue_650104"
  - dialogueId: 650105
    groupId: 1
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "파낸 자리에서 흙이 우수수 흘러내립니다."
    scriptKey: "relic_dialogue_650105"
  - dialogueId: 650106
    groupId: 1
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "박동이 멎었습니다. 손에 남은 것을 확인합니다."
    scriptKey: "relic_dialogue_650106"
  - dialogueId: 650201
    groupId: 2
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "굳은 껍질 같은 것이 지면 위로 반쯤 드러나 있습니다.\n이 몸이 언젠가 스스로 만들어 덮었던 자리입니다."
    scriptKey: "relic_dialogue_650201"
  - dialogueId: 650202
    groupId: 2
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "낡은 딱지가 흙과 뒤엉켜 있습니다.\n떼어내면 그 아래에 무엇이 있을지 알 수 없습니다."
    scriptKey: "relic_dialogue_650202"
  - dialogueId: 650203
    groupId: 2
    situation: 2
    choiceGroupId: 640002
    weight: 10
    script: "껍질을 걷어내자 아래의 살이 드러납니다.\n아직 따뜻합니다."
    scriptKey: "relic_dialogue_650203"
  - dialogueId: 650204
    groupId: 2
    situation: 3
    choiceGroupId: 640002
    weight: 10
    script: "덮인 것을 그대로 둡니다.\n아무는 중인 자리를 굳이 열 이유는 없습니다."
    scriptKey: "relic_dialogue_650204"
  - dialogueId: 650205
    groupId: 2
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "껍질 아래에 있던 것을 손에 넣었습니다."
    scriptKey: "relic_dialogue_650205"
  - dialogueId: 650206
    groupId: 2
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "떼어낸 자리에서 옅은 김이 오릅니다."
    scriptKey: "relic_dialogue_650206"
  - dialogueId: 650301
    groupId: 3
    situation: 1
    choiceGroupId: 640003
    weight: 10
    script: "삭은 뼛조각이 흙 위로 삐죽 나와 있습니다.\n무엇이 여기서 죽었는지 아는 이가 없습니다. 위험이 도사리고 있을지도 모릅니다...."
    scriptKey: "relic_dialogue_650301"
  - dialogueId: 650302
    groupId: 3
    situation: 1
    choiceGroupId: 640003
    weight: 10
    script: "썩은 냄새가 옅게 올라옵니다.\n파묻힌 것이 완전히 죽었다는 보장은 없습니다."
    scriptKey: "relic_dialogue_650302"
  - dialogueId: 650303
    groupId: 3
    situation: 2
    choiceGroupId: 640003
    weight: 10
    script: "천사 하나가 뼛조각을 잡고 힘껏 당깁니다.\n생각보다 깊이 박혀 있었습니다."
    scriptKey: "relic_dialogue_650303"
  - dialogueId: 650304
    groupId: 3
    situation: 3
    choiceGroupId: 640003
    weight: 10
    script: "천사들은 코를 막고 물러섭니다.\n죽은 것을 굳이 깨울 필요는 없습니다."
    scriptKey: "relic_dialogue_650304"
  - dialogueId: 650305
    groupId: 3
    situation: 4
    choiceGroupId: 640003
    weight: 10
    script: "뽑아낸 자리에 검은 물이 고입니다."
    scriptKey: "relic_dialogue_650305"
  - dialogueId: 650306
    groupId: 3
    situation: 4
    choiceGroupId: 640003
    weight: 10
    script: "잔해를 헤집어 쓸 만한 것을 골라냈습니다."
    scriptKey: "relic_dialogue_650306"
  - dialogueId: 650401
    groupId: 4
    situation: 1
    choiceGroupId: 640004
    weight: 10
    script: "그 자리만 유독 따뜻합니다.\n발바닥으로 전해지는 온기가 성역의 것과 닮았습니다."
    scriptKey: "relic_dialogue_650401"
  - dialogueId: 650402
    groupId: 4
    situation: 1
    choiceGroupId: 640004
    weight: 10
    script: "눈이 닿지 않는 곳에서 무언가가 열을 내고 있습니다.\n좋은 징조인지는 알 수 없습니다."
    scriptKey: "relic_dialogue_650402"
  - dialogueId: 650403
    groupId: 4
    situation: 2
    choiceGroupId: 640004
    weight: 10
    script: "온기를 따라 흙을 걷어냅니다.\n손이 데일 만큼 뜨거워집니다."
    scriptKey: "relic_dialogue_650403"
  - dialogueId: 650404
    groupId: 4
    situation: 3
    choiceGroupId: 640004
    weight: 10
    script: "온기를 등지고 돌아섭니다.\n따뜻한 것이 언제나 안전하지는 않습니다."
    scriptKey: "relic_dialogue_650404"
  - dialogueId: 650405
    groupId: 4
    situation: 4
    choiceGroupId: 640004
    weight: 10
    script: "열이 가라앉고, 남은 것이 드러납니다."
    scriptKey: "relic_dialogue_650405"
  - dialogueId: 650406
    groupId: 4
    situation: 4
    choiceGroupId: 640004
    weight: 10
    script: "다 식은 자리에서 무언가를 집어 올렸습니다."
    scriptKey: "relic_dialogue_650406"
  - dialogueId: 650501
    groupId: 5
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "누군가 이미 파헤쳤다 덮은 흔적이 있습니다.\n덮은 쪽이 우리 편이었는지는 알 수 없습니다. 위험이 도사리고 있을지도 모릅니다...."
    scriptKey: "relic_dialogue_650501"
  - dialogueId: 650502
    groupId: 5
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "흙 위에 낯선 자국이 남아 있습니다.\n무엇이 지나갔는지, 무엇을 두고 갔는지 모릅니다."
    scriptKey: "relic_dialogue_650502"
  - dialogueId: 650503
    groupId: 5
    situation: 2
    choiceGroupId: 640002
    weight: 10
    script: "남의 손이 닿았던 자리를 다시 엽니다.\n두 번째로 파는 흙은 언제나 더 빨리 열립니다."
    scriptKey: "relic_dialogue_650503"
  - dialogueId: 650504
    groupId: 5
    situation: 3
    choiceGroupId: 640002
    weight: 10
    script: "천사들은 자국을 밟지 않고 지나갑니다.\n남이 덮은 것을 여는 것은 마지막 순서입니다."
    scriptKey: "relic_dialogue_650504"
  - dialogueId: 650505
    groupId: 5
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "먼저 다녀간 자가 놓치고 간 것이 있었습니다."
    scriptKey: "relic_dialogue_650505"
  - dialogueId: 650506
    groupId: 5
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "덮여 있던 것을 마저 걷어냈습니다."
    scriptKey: "relic_dialogue_650506"
  - dialogueId: 650601
    groupId: 6
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "성역의 결이 그 자리를 향해 미세하게 끌립니다.\n몸이 스스로 무언가를 알리려는 것 같습니다."
    scriptKey: "relic_dialogue_650601"
  - dialogueId: 650602
    groupId: 6
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "성역의 박동이 그 방향에서 한 박자 어긋납니다.\n확인해 보지 않으면 알 수 없습니다."
    scriptKey: "relic_dialogue_650602"
  - dialogueId: 650603
    groupId: 6
    situation: 2
    choiceGroupId: 640001
    weight: 10
    script: "부름을 따라 천사가 걸어갑니다.\n가까워질수록 결이 또렷해집니다."
    scriptKey: "relic_dialogue_650603"
  - dialogueId: 650604
    groupId: 6
    situation: 3
    choiceGroupId: 640001
    weight: 10
    script: "부름을 못 들은 척합니다.\n지금은 지켜야 할 것이 더 가까이 있습니다."
    scriptKey: "relic_dialogue_650604"
  - dialogueId: 650605
    groupId: 6
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "어긋났던 박자가 제자리를 찾습니다."
    scriptKey: "relic_dialogue_650605"
  - dialogueId: 650606
    groupId: 6
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "성역이 알리려던 것을 손에 쥐었습니다."
    scriptKey: "relic_dialogue_650606"
  - dialogueId: 650901
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "쓰러진 것의 몸에서 아직 뛰는 조각을 떼어냈습니다.\n이제 이것은 성역의 것입니다."
    scriptKey: "relic_dialogue_650901"
  - dialogueId: 650902
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "적의 형상이 무너지고, 무너지지 않은 것 하나가 남았습니다.\n몸은 그것을 곧바로 제 것으로 삼습니다."
    scriptKey: "relic_dialogue_650902"
  - dialogueId: 650903
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "삼킨 자를 삼켰습니다.\n빼앗은 것에서 아직 그것의 온도가 느껴집니다."
    scriptKey: "relic_dialogue_650903"
  - dialogueId: 650904
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "죽은 침입자의 안쪽에서 낯선 기관이 드러납니다.\n쓸모를 알아보는 데는 오래 걸리지 않았습니다."
    scriptKey: "relic_dialogue_650904"
  - dialogueId: 650905
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "성역은 적의 것을 버리지 않습니다.\n무너뜨린 것의 일부가 그대로 이 몸의 일부가 됩니다."
    scriptKey: "relic_dialogue_650905"
  choices:
  - choiceGroupId: 640001
    choiceId: 340001
    choiceOrder: 1
    kind: 1
    choiceText: "가까이 가서 살펴본다."
    choiceTextKey: "dig_choice_text_340001"
  - choiceGroupId: 640001
    choiceId: 340002
    choiceOrder: 2
    kind: 2
    choiceText: "방심은 금물이다. 그냥 두자."
    choiceTextKey: "dig_choice_text_340002"
  - choiceGroupId: 640002
    choiceId: 340003
    choiceOrder: 1
    kind: 1
    choiceText: "파낸다. 여기까지 온 이유가 있다."
    choiceTextKey: "dig_choice_text_340003"
  - choiceGroupId: 640002
    choiceId: 340004
    choiceOrder: 2
    kind: 2
    choiceText: "지금은 아니다. 표시만 해 둔다."
    choiceTextKey: "dig_choice_text_340004"
  - choiceGroupId: 640003
    choiceId: 340005
    choiceOrder: 1
    kind: 1
    choiceText: "누군가를 보내 손을 넣게 한다."
    choiceTextKey: "dig_choice_text_340005"
  - choiceGroupId: 640003
    choiceId: 340006
    choiceOrder: 2
    kind: 2
    choiceText: "성역의 아이를 위험에 두지 않는다."
    choiceTextKey: "dig_choice_text_340006"
  - choiceGroupId: 640004
    choiceId: 340007
    choiceOrder: 1
    kind: 1
    choiceText: "덮인 것을 걷어낸다."
    choiceTextKey: "dig_choice_text_340007"
  - choiceGroupId: 640004
    choiceId: 340008
    choiceOrder: 2
    kind: 2
    choiceText: "덮여 있는 데는 이유가 있다. 덮어 둔다."
    choiceTextKey: "dig_choice_text_340008"
