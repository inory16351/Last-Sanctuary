%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c0060fe4ab43d4428251652a4b7f6c1, type: 3}
  m_Name: RelicDialogueTable
  m_EditorClassIdentifier:
  lines:
  - dialogueId: 650101
    groupId: 1
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "흙이 부자연스럽게 부풀어 올랐습니다.\n무언가 묻혀 있는 것은 분명하나, 위험이 도사리고 있을지도 모릅니다...."
  - dialogueId: 650102
    groupId: 1
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "지면 아래에서 미약한 박동이 올라옵니다.\n성역의 것이라 하기에는 박자가 어긋나 있습니다."
  - dialogueId: 650103
    groupId: 1
    situation: 2
    choiceGroupId: 640001
    weight: 10
    script: "한 천사가 조심스레 다가가 흙을 헤집습니다.\n손끝에 단단한 것이 걸립니다."
  - dialogueId: 650104
    groupId: 1
    situation: 3
    choiceGroupId: 640001
    weight: 10
    script: "천사들은 그곳을 멀찍이 돌아갑니다.\n부푼 흙은 부푼 채로 남았습니다."
  - dialogueId: 650105
    groupId: 1
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "파낸 구멍으로 흙이 우수수 흘러내립니다."
  - dialogueId: 650106
    groupId: 1
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "박동이 멎었고, 손에 쥔 것만이 남았습니다."
  - dialogueId: 650201
    groupId: 2
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "굳은 껍질 하나가 지면 위로 반쯤 드러나 있습니다.\n이 몸이 언젠가 스스로 지어 덮어 둔 자리입니다."
  - dialogueId: 650202
    groupId: 2
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "낡은 딱지가 흙과 뒤엉킨 채 굳었습니다.\n떼어내기 전에는 그 아래를 짐작할 방법이 없습니다."
  - dialogueId: 650203
    groupId: 2
    situation: 2
    choiceGroupId: 640002
    weight: 10
    script: "껍질을 걷어내자 아물다 만 살이 드러납니다.\n아직 온기가 남아 있습니다."
  - dialogueId: 650204
    groupId: 2
    situation: 3
    choiceGroupId: 640002
    weight: 10
    script: "덮인 것을 그대로 둡니다.\n아물고 있는 살을 굳이 열 이유는 없습니다."
  - dialogueId: 650205
    groupId: 2
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "껍질 아래에 잠들어 있던 것을 거두었습니다."
  - dialogueId: 650206
    groupId: 2
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "떼어낸 자리에서 옅은 김이 피어오릅니다."
  - dialogueId: 650301
    groupId: 3
    situation: 1
    choiceGroupId: 640003
    weight: 10
    script: "삭은 뼛조각이 지면 위로 삐죽 솟아 있습니다.\n무엇이 여기서 최후를 맞았는지는 기록에 남은 바가 없습니다."
  - dialogueId: 650302
    groupId: 3
    situation: 1
    choiceGroupId: 640003
    weight: 10
    script: "썩은 냄새가 옅게 올라옵니다.\n파묻힌 것이 완전히 죽었다는 보장은 어디에도 없습니다."
  - dialogueId: 650303
    groupId: 3
    situation: 2
    choiceGroupId: 640003
    weight: 10
    script: "뼛조각을 붙들고 힘껏 당깁니다.\n짐작보다 깊이 박혀 있었습니다."
  - dialogueId: 650304
    groupId: 3
    situation: 3
    choiceGroupId: 640003
    weight: 10
    script: "대열은 코를 막고 물러섭니다.\n죽은 것을 굳이 깨울 까닭은 없습니다."
  - dialogueId: 650305
    groupId: 3
    situation: 4
    choiceGroupId: 640003
    weight: 10
    script: "뽑아낸 자리에 검은 물이 고입니다."
  - dialogueId: 650306
    groupId: 3
    situation: 4
    choiceGroupId: 640003
    weight: 10
    script: "잔해를 헤집어 쓸 만한 것만 골라냈습니다."
  - dialogueId: 650401
    groupId: 4
    situation: 1
    choiceGroupId: 640004
    weight: 10
    script: "그 땅만 유독 따뜻합니다.\n발바닥으로 전해지는 온기가 성역의 것과 닮았습니다."
  - dialogueId: 650402
    groupId: 4
    situation: 1
    choiceGroupId: 640004
    weight: 10
    script: "눈이 닿지 않는 깊이에서 열이 올라옵니다.\n좋은 징조로 여기기에는 지나치게 뜨겁습니다."
  - dialogueId: 650403
    groupId: 4
    situation: 2
    choiceGroupId: 640004
    weight: 10
    script: "온기를 좇아 흙을 걷어냅니다.\n깊어질수록 손끝이 익어 갑니다."
  - dialogueId: 650404
    groupId: 4
    situation: 3
    choiceGroupId: 640004
    weight: 10
    script: "그 열을 등지고 돌아섭니다.\n따뜻한 것이 곧 안전한 것은 아닙니다."
  - dialogueId: 650405
    groupId: 4
    situation: 4
    choiceGroupId: 640004
    weight: 10
    script: "열이 가라앉자 남은 것의 윤곽이 드러납니다."
  - dialogueId: 650406
    groupId: 4
    situation: 4
    choiceGroupId: 640004
    weight: 10
    script: "열이 식은 뒤에야 하나를 집어 올렸습니다."
  - dialogueId: 650501
    groupId: 5
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "누군가 파헤쳤다 도로 덮은 흔적이 있습니다.\n덮은 쪽이 우리 편이었다는 증거는 어디에도 없습니다."
  - dialogueId: 650502
    groupId: 5
    situation: 1
    choiceGroupId: 640002
    weight: 10
    script: "흙 위에 낯선 자국이 찍혀 있습니다.\n무엇이 지나갔고 무엇을 두고 갔는지는 자국만으로 읽히지 않습니다."
  - dialogueId: 650503
    groupId: 5
    situation: 2
    choiceGroupId: 640002
    weight: 10
    script: "남의 손이 닿았던 곳을 다시 헤칩니다.\n한 번 열린 땅은 훨씬 수월하게 벌어집니다."
  - dialogueId: 650504
    groupId: 5
    situation: 3
    choiceGroupId: 640002
    weight: 10
    script: "대열은 자국을 밟지 않고 지나갑니다.\n남이 덮은 것을 여는 일은 맨 마지막 순서입니다."
  - dialogueId: 650505
    groupId: 5
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "먼저 다녀간 자가 놓치고 간 것이 있었습니다."
  - dialogueId: 650506
    groupId: 5
    situation: 4
    choiceGroupId: 640002
    weight: 10
    script: "덮여 있던 나머지를 걷어냈습니다."
  - dialogueId: 650601
    groupId: 6
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "성역의 결이 한 지점을 향해 미세하게 쏠립니다.\n몸이 제 안의 어딘가를 짚고 있습니다."
  - dialogueId: 650602
    groupId: 6
    situation: 1
    choiceGroupId: 640001
    weight: 10
    script: "넥서스의 맥이 그 방향에서 한 박자 어긋납니다.\n어긋난 곳이 비어 있는 경우는 드뭅니다."
  - dialogueId: 650603
    groupId: 6
    situation: 2
    choiceGroupId: 640001
    weight: 10
    script: "부름을 따라 한 천사가 걸어 들어갑니다.\n가까워질수록 결이 또렷해집니다."
  - dialogueId: 650604
    groupId: 6
    situation: 3
    choiceGroupId: 640001
    weight: 10
    script: "부름을 못 들은 척합니다.\n지금 지켜야 할 것이 더 가까이 있습니다."
  - dialogueId: 650605
    groupId: 6
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "어긋났던 박자가 제자리를 찾습니다."
  - dialogueId: 650606
    groupId: 6
    situation: 4
    choiceGroupId: 640001
    weight: 10
    script: "성역이 가리키던 것을 손에 쥐었습니다."
  - dialogueId: 650901
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "쓰러진 것의 몸에서 아직 뛰는 조각을 떼어냈습니다.\n이제 이것은 성역의 것입니다."
  - dialogueId: 650902
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "적의 형상이 무너지고, 무너지지 않은 하나가 남았습니다.\n몸은 그것을 곧바로 제 것으로 셈합니다."
  - dialogueId: 650903
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "삼키던 자를 삼켰습니다.\n빼앗은 것에서 아직 그 온도가 느껴집니다."
  - dialogueId: 650904
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "죽은 침입자의 안쪽에서 낯선 기관이 드러납니다.\n쓸모를 알아보는 데에는 오래 걸리지 않았습니다."
  - dialogueId: 650905
    groupId: 0
    situation: 5
    choiceGroupId: 0
    weight: 10
    script: "성역은 적의 것이라 하여 버리지 않습니다.\n무너뜨린 것의 일부가 그대로 이 몸의 일부가 됩니다."
  choices:
  - choiceGroupId: 640001
    choiceId: 340001
    choiceOrder: 1
    kind: 1
    choiceText: "가까이 가서 살펴본다."
  - choiceGroupId: 640001
    choiceId: 340002
    choiceOrder: 2
    kind: 2
    choiceText: "방심은 금물이다. 그냥 두자."
  - choiceGroupId: 640002
    choiceId: 340003
    choiceOrder: 1
    kind: 1
    choiceText: "파낸다. 여기까지 온 까닭이 있다."
  - choiceGroupId: 640002
    choiceId: 340004
    choiceOrder: 2
    kind: 2
    choiceText: "지금은 아니다. 어디였는지만 기억해 둔다."
  - choiceGroupId: 640003
    choiceId: 340005
    choiceOrder: 1
    kind: 1
    choiceText: "한 사람을 보내 손을 넣게 한다."
  - choiceGroupId: 640003
    choiceId: 340006
    choiceOrder: 2
    kind: 2
    choiceText: "성역의 아이를 위험에 두지 않는다."
  - choiceGroupId: 640004
    choiceId: 340007
    choiceOrder: 1
    kind: 1
    choiceText: "덮인 것을 걷어낸다."
  - choiceGroupId: 640004
    choiceId: 340008
    choiceOrder: 2
    kind: 2
    choiceText: "가려져 있는 데에는 까닭이 있을 것이다."
