  eventId: 205009
  eventName: "전열의 재편"
  triggerCond: "wave_end"
  triggerValue: 0
  weight: 10
  repeatable: 1
  choiceGroupId: 600009
  eventBg: "bg_formation"
  eventScript: "전위의 천사들이 너무 많이 상했습니다.\n뒤에 선 손이 앞으로 나와야 할지, 앞이 조금 더 버텨야 할지 정할 시간입니다."
  choices:
  - choiceId: 300017
    choiceOrder: 1
    choiceText: "앞을 더 두껍게 세워라."
    resultScript: "방패를 든 천사들이 어깨를 붙이고 벽이 되었습니다.\n두꺼워진 벽은 좀처럼 자리를 옮기지 못합니다."
    resultEffect: "효과 : 천사 전체 방어력 +10% (240초) · 천사 전체 이동 속도 −6% (240초)"
    rewardType01: "char_def_durat_up"
    rewardValue01: 10
    rewardDuration01: 240
    rewardType02: "char_move_spd_durat_down"
    rewardValue02: 6
    rewardDuration02: 240
  - choiceId: 300018
    choiceOrder: 2
    choiceText: "뒤에서 더 멀리 쏜다."
    resultScript: "전열은 사거리를 벌려 적을 먼 데서 끊기로 했습니다.\n화살이 멀리 나가는 사이 앞줄은 얇아졌습니다."
    resultEffect: "효과 : 천사 전체 공격 사거리 +10% (240초) · 천사 전체 방어력 −6% (240초)"
    rewardType01: "char_range_durat_up"
    rewardValue01: 10
    rewardDuration01: 240
    rewardType02: "char_def_durat_down"
    rewardValue02: 6
    rewardDuration02: 240
