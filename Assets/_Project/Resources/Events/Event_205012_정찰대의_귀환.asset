  scriptKey: "event_script_205012"
  choices:
  - choiceId: 300023
    choiceOrder: 1
    choiceText: "본 것을 전부 말하게 한다."
    resultScript: "천사들의 입에서 안개 너머의 모양이 쏟아졌습니다.\n성역은 그 모양을 알게 되었고, 알게 된 값을 함께 치릅니다."
    resultEffect: "효과 : 천사 전체 시야 +12% (240초) · 천사 전체 침식 +8"
    choiceTextKey: "event_choice_text_300023"
    resultScriptKey: "event_result_script_300023"
    resultEffectKey: "event_result_effect_300023"
    rewardType01: "char_vision_durat_up"
    rewardValue01: 12
