  eventId: 205006
  eventName: "봉화의 흔적"
  triggerCond: "wave_end"
  triggerValue: 0
  weight: 8
  repeatable: 1
  choiceGroupId: 600006
  eventBg: "bg_fog"
  eventScript: "파도가 물러난 자리에 낯선 표식이 남았습니다.\n누군가가—혹은 무언가가—성역의 안쪽을 향해 길을 알려 두었습니다."
  choices:
  - choiceId: 300011
    choiceOrder: 1
    choiceText: "표식을 따라가 본다."
    resultScript: "천사들은 표식을 좇아 안개 밖으로 눈을 뻗었습니다.\n보이는 것이 늘어난 만큼, 닿을 수 있는 거리도 늘었습니다."
    resultEffect: "효과 : 천사 전체 시야 +10% (240초) · 천사 전체 공격 사거리 +8% (240초)"
    rewardType01: "char_vision_durat_up"
    rewardValue01: 10
    rewardDuration01: 240
    rewardType02: "char_range_durat_up"
    rewardValue02: 8
    rewardDuration02: 240
  - choiceId: 300012
    choiceOrder: 2
    choiceText: "표식을 지운다."
    resultScript: "천사들은 표식을 발로 문질러 없앴습니다.\n길을 잃은 것들이 성역의 문 앞에서 헤매기 시작합니다."
    resultEffect: "효과 : 적 전체 이동 속도 −10% (240초) · 천사 전체 방어력 +5% (240초)"
    rewardType01: "enemy_move_spd_durat_down"
    rewardValue01: 10
    rewardDuration01: 240
    rewardType02: "char_def_durat_up"
    rewardValue02: 5
    rewardDuration02: 240
