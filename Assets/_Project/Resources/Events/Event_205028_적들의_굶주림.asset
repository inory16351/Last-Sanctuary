  eventName: "적들의 굶주림"
  triggerCond: "wave_end"
  triggerValue: 0
  weight: 8
  repeatable: 1
  choiceGroupId: 600028
  eventBg: "bg_fog"
  eventScript: "성역 밖의 악마들이 서로를 물어뜯기 시작했습니다.\n먹을 것이 끊긴 무리는 언제나 안에서부터 무너집니다."
  choices:
  - choiceId: 300055
    choiceOrder: 1
    choiceText: "굶주림이 깊어질 때까지 기다린다."
    resultScript: "문 안쪽에서, 저들이 말라가는 것을 지켜보았습니다.\n다음에 문을 두드릴 손은 훨씬 가벼울 것입니다."
    resultEffect: "효과 : 적 전체 공격력 −10% (120초) · 적 전체 방어력 −10% (120초)"
    rewardType01: "enemy_atk_durat_down"
    rewardValue01: 10
    rewardDuration01: 120
    rewardType02: "enemy_def_durat_down"
    rewardValue02: 10
    rewardDuration02: 120
  - choiceId: 300056
    choiceOrder: 2
    choiceText: "지금 쳐서 무리를 흩는다."
    resultScript: "천사들은 굶주린 무리 속으로 뛰어들어 대열을 끊었습니다.\n흩어진 것들은 느려졌고, 뛰어든 쪽도 살을 잃었습니다."
    resultEffect: "효과 : 적 전체 공격 속도 −10% (120초) · 천사 전체 체력 −8% (최대 체력 기준)"
    rewardType01: "enemy_atk_spd_durat_down"
    rewardValue01: 10
    rewardDuration01: 120
    rewardType02: "char_hp_percent_loss"
    rewardValue02: 8
    rewardDuration02: 0
