  eventId: 205008
  eventName: "남겨진 파편"
  triggerCond: "wave_end"
  triggerValue: 0
  weight: 12
  repeatable: 1
  choiceGroupId: 600008
  eventBg: "bg_aftermath"
  eventScript: "유해를 걷어낸 자리에 적의 파편이 반짝입니다.\n성역의 것이 아닌 재료입니다. 쓸 수야 있겠으나, 이 몸이 받아들일지는 별개의 문제입니다."
  choices:
  - choiceId: 300015
    choiceOrder: 1
    choiceText: "몸에 박아 넣는다."
    resultScript: "이질적인 파편이 천사들의 살에 자리를 잡았습니다.\n힘은 분명히 늘었고, 그 자리는 이제 성역의 것이 아닙니다."
    resultEffect: "효과 : 천사 전체 근거리 공격력 +10% (120초) · 천사 전체 저항력 −8% (240초)"
    rewardType01: "char_melee_atk_durat_up"
    rewardValue01: 10
    rewardDuration01: 120
    rewardType02: "char_resist_durat_down"
    rewardValue02: 8
    rewardDuration02: 240
  - choiceId: 300016
    choiceOrder: 2
    choiceText: "태워서 양분으로 삼는다."
    resultScript: "파편은 불 속에서 성역이 삼킬 수 있는 형태로 바뀌었습니다.\n낯선 것을 낯익은 것으로 바꾸는 일이 곧 면역입니다."
    resultEffect: "효과 : 에너지 +250"
    rewardType01: "energy_gain"
    rewardValue01: 250
    rewardDuration01: 0
    rewardType02: ""
    rewardValue02: 0
    rewardDuration02: 0
