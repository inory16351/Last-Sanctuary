  eventName: "대가 없는 은혜"
  triggerCond: "wave_end"
  triggerValue: 0
  weight: 6
  repeatable: 1
  choiceGroupId: 600020
  eventBg: "bg_nexus"
  eventScript: "이유를 알 수 없이 성역이 천사들을 감쌉니다.\n이런 종류의 호의는 대개 값이 뒤에 붙습니다."
  choices:
  - choiceId: 300039
    choiceOrder: 1
    choiceText: "받는다."
    resultScript: "천사들의 몸에 얇은 막이 씌워졌습니다.\n지금 이 온기가 무엇으로 만들어졌는지는 묻지 않기로 했습니다."
    resultEffect: "효과 : 천사 전체 보호막 (최대 체력의 12%, 240초) · 천사 전체 받는 회복량 +15% (240초)"
    rewardType01: "char_shield_gain"
    rewardValue01: 12
    rewardDuration01: 240
    rewardType02: "char_heal_receive_up"
    rewardValue02: 15
    rewardDuration02: 240
  - choiceId: 300040
    choiceOrder: 2
    choiceText: "사양한다."
    resultScript: "천사들은 뻗어온 손을 정중히 물렸습니다.\n받지 않은 것에는 값도 붙지 않습니다."
    resultEffect: "효과 : 천사 전체 침식 −12"
    rewardType01: "char_all_erosion_down"
    rewardValue01: 12
    rewardDuration01: 0
    rewardType02: ""
    rewardValue02: 0
    rewardDuration02: 0
