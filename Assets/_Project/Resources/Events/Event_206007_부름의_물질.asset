  choiceGroupId: 600035
  eventBg: "bg_mana"
  eventScript: "성역 어딘가에서 신호 물질이 퍼집니다.\n부름을 받은 천사들의 몸이 저절로 그 방향을 향합니다."
  choices:
  - choiceId: 300069
    choiceOrder: 1
    choiceText: "부름을 따른다."
    resultScript: "부르는 쪽으로 대열이 통째로 쏟아져 나갔습니다.\n걸음은 빨라지고 시야는 넓어졌으나, 등 뒤가 비었습니다."
    resultEffect: "효과 : 천사 전체 이동 속도 +12% (180초) · 천사 전체 방어력 −6% (180초)"
    rewardType01: "char_move_spd_durat_up"
    rewardValue01: 12
    rewardDuration01: 180
    rewardType02: "char_def_durat_down"
    rewardValue02: 6
    rewardDuration02: 180
  - choiceId: 300070
    choiceOrder: 2
    choiceText: "자리를 지킨다."
    resultScript: "부름은 무시되었습니다.\n제자리에 박힌 천사들은 느리지만 쉽게 뚫리지 않습니다."
    resultEffect: "효과 : 천사 전체 방어력 +10% (180초) · 천사 전체 이동 속도 −6% (180초)"
    rewardType01: "char_def_durat_up"
